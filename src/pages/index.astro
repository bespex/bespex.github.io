---
import Platforms from "../components/Platforms.astro";
import Base from "../layouts/Base.astro";
import AppCard from "../components/AppCard.astro";
import Shot from "../components/Shot.astro";
import Command from "../components/Command.astro";
import { appsOf, featured, groups, iconOf, onWindows, previewsOf, released, shown, standalone } from "../data/apps";

const packages = released.map((a) => a.pkg).join(" ");
/** Released apps that also run on Windows: the site says "for Linux" only as long as there are none. */
const forWindows = released.filter(onWindows);
const alsoWindows = forWindows.length > 0 ? " – some also for Windows" : "";
const photoSorter = shown.some((a) => a.slug === "pictorix") ? "; a photo sorter" : "";
/** Who makes the apps and which there are, for search engines. */
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "be spex",
      url: Astro.site!.href,
      logo: new URL("/be-spex.png", Astro.site).href,
      sameAs: ["https://github.com/bespex"],
    },
    { "@type": "WebSite", name: "be spex", url: Astro.site!.href },
    {
      "@type": "ItemList",
      name: "Apps by be spex",
      itemListElement: released.map((a, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `${a.name} – ${a.kind}`,
        url: new URL(`/${a.slug}/`, Astro.site).href,
      })),
    },
  ],
};
---
<Base
  title="be spex – apps for the way you work"
  description={`be spex makes free desktop apps for Linux${alsoWindows}: CodeDeck, which shows what your AI coding sessions do and lets you go back to any turn; quick viewers for React components (TSX/JSX), Markdown, JSON, XML, HTML, CSV, diffs and Mermaid diagrams; mail in your tray; work contexts with a time log; a tidy system tray${photoSorter}.`}
  schema={schema}
>
  <section class="hero wrap">
    <header class="hero-head">
      <p class="eyebrow">Open-source apps for Linux{alsoWindows}</p>
      <h1>Apps for the <em>way you work</em>.</h1>
    </header>

    <div class="hero-halves">
      <article class="lead-app" style={`--accent: ${featured.accent}`}>
        <a class="lead-link" href={`/${featured.slug}/`} aria-label={`${featured.name} – ${featured.kind}`}>
          <header>
            <img src={iconOf(featured)} alt="" width="64" height="64" />
            <div>
              <h2>{featured.name}</h2>
              <p class="kind">{featured.kind}</p>
            </div>
          </header>
          <p class="lead-line">The <em>control deck</em> for your AI coding sessions.</p>
          <p class="lead-text">
            See what each session is doing and what it changed, go back to the state before any turn, and choose exactly
            what goes with your next prompt. It runs beside your coding agent, not instead of it.
          </p>
          <Shot shot={{ ...featured.shots[0], alt: "" }} eager />
          <ul class="points">
            {featured.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </a>
        <p class="actions">
          <a class="btn primary" href={`/${featured.slug}/`}>More about CodeDeck</a>
          <a class="btn" href="#install">Install with APT</a>
        </p>
      </article>

      <div class="others">
        <p class="eyebrow">And more from be spex</p>
        <h2>Small tools that do <em>one thing</em> well.</h2>
        <p class="lead">
          Desktop apps for Linux{forWindows.length > 0 && ", some also for Windows,"} that open in an instant, stay out of your way and are
          pleasant to use. Free, open source, and made for everyday work.
        </p>
        <div class="dock">
          {groups.map((g) => (
            <div class="dock-group tinted">
              <p class="dock-label">{g.name} · {g.kind}</p>
              <ul aria-label={`${g.name}: ${g.kind}`}>
                {appsOf(g.id).map((a) => (
                  <li>
                    <a href={`/${a.slug}/`} title={`${a.name} – ${a.kind}`}>
                      <img src={iconOf(a)} alt="" width="56" height="56" />
                      <span class="dock-text">
                        <strong>{a.name}</strong>
                        <small>{a.kind}<Platforms app={a} /></small>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div class="dock-group">
            <p class="dock-label">Desktop apps</p>
            <ul aria-label="Desktop apps">
              {standalone.map((a) => (
                <li>
                  <a href={`/${a.slug}/`} title={`${a.name} – ${a.kind}`}>
                    <img src={iconOf(a)} alt="" width="56" height="56" />
                    <span class="dock-text">
                      <strong>{a.name}</strong>
                      <small>{a.kind}<Platforms app={a} /></small>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <p class="actions"><a class="btn" href="#apps">Browse all apps</a></p>
      </div>
    </div>
  </section>

  <div id="apps">
    {groups.map((g) => (
      <section class="group wrap" id={g.id}>
        <header class="section-head">
          <p class="eyebrow">{g.kind}</p>
          <h2>{g.name} <span>{g.tagline}</span></h2>
          <p class="lead">{g.description}</p>
        </header>
        <div class:list={["cards", { even: appsOf(g.id).length % 3 === 1 }]}>
          {appsOf(g.id).map((a) => <AppCard app={a} />)}
        </div>
        <ul class="shared">
          {g.shared.map((s) => (
            <li><strong>{s.title}</strong>{s.text}</li>
          ))}
        </ul>
        {previewsOf(g.id).length > 0 && (
          <div class="next" id={`${g.id}-next`}>
            <header class="next-head">
              <p class="eyebrow">Coming next</p>
              <h3>More {g.name} viewers are on their way</h3>
              <p>They already work and can be built from source; the release and the APT packages follow.</p>
            </header>
            <div class:list={["cards", { even: previewsOf(g.id).length % 3 === 1 }]}>
              {previewsOf(g.id).map((a) => <AppCard app={a} />)}
            </div>
          </div>
        )}
      </section>
    ))}

    <section class="desktop wrap" id="desktop">
      <header class="section-head">
        <p class="eyebrow">Desktop apps</p>
        <h2>More for the desktop <span>Apps that stay with you all day.</span></h2>
      </header>
      <div class:list={["cards", { even: standalone.length % 3 === 1 }]}>
        {standalone.map((a) => <AppCard app={a} />)}
      </div>
    </section>
  </div>

  <section class="install wrap" id="install">
    <header class="section-head">
      <p class="eyebrow">Install</p>
      <h2>Add the repository once, then <code>apt</code> keeps everything current.</h2>
      <p class="lead">
        For Debian, Ubuntu and Linux Mint (Ubuntu 24.04+, Mint 22+, Debian 13+). The packages are
        signed; updates arrive with your normal system updates.
      </p>
    </header>
    <div class="install-grid">
      <div>
        <h3>1 · Add the be spex repository</h3>
        <Command
          lines={[
            "curl -fsSLO https://bespex.run/apt/be-spex-archive-keyring.deb",
            "sudo apt install ./be-spex-archive-keyring.deb && sudo apt update",
          ]}
        />
        <h3>2 · Install what you like</h3>
        <Command lines={[`sudo apt install ${packages}`]} />
      </div>
      <aside>
        <h3>Another distribution?</h3>
        <p>
          Most apps also come as an <strong>AppImage</strong>: one file that runs as it is and
          updates itself. You find it on each app's page.
        </p>
        {forWindows.length > 0 && (
          <p>
            <strong>Windows?</strong>
            {forWindows.map((a, i) => <>{i > 0 && ", "}<a href={`/${a.slug}/#get`}>{a.name}</a></>)} also
            {forWindows.length > 1 ? " come" : " comes"} as an installer for Windows 10 and 11 that updates itself.
          </p>
        )}
        <p>
          The signing key is also available as <a href="/key.asc">ASCII</a> for other tools.
          <a href="/apt/">Details and manual setup of the repository →</a>
        </p>
      </aside>
    </div>
  </section>

  <section class="open wrap" id="open-source">
    <div class="open-text">
      <p class="eyebrow">Open source</p>
      <h2>Open code, open door.</h2>
      <p class="lead">
        Everything here is free software under the MIT licence (PocketTray: GPL, like the Cinnamon applets it builds on). Read the code, build it yourself,
        change it – and if something is missing or broken, say so.
      </p>
      <ul class="ways">
        <li>
          <strong>Report a problem</strong>
          Open an issue in the app's repository; a file that shows the problem helps a lot.
        </li>
        <li>
          <strong>Suggest an idea</strong>
          The apps stay small on purpose, but good ideas for what they do are welcome.
        </li>
        <li>
          <strong>Contribute</strong>
          Pull requests are welcome. Each repository explains how to build and where things are.
        </li>
      </ul>
      <p class="actions">
        <a class="btn primary" href="https://github.com/bespex">be spex on GitHub</a>
      </p>
    </div>
    <img class="badge" src="/be-spex-badge.webp" alt="be spex" width="400" height="400" loading="lazy" />
  </section>
</Base>
