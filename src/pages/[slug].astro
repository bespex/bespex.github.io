---
import Platforms from "../components/Platforms.astro";
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import Command from "../components/Command.astro";
import { existsSync } from "node:fs";
import { apps, groups, iconOf, onWindows, platformText, sourceUrl, tryOf, type App } from "../data/apps";
import { latestRelease } from "../lib/releases";

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

interface Props {
  app: App;
}
const { app } = Astro.props;
const group = groups.find((g) => g.id === app.group);
const siblings = group ? apps.filter((a) => a.group === group.id && a.slug !== app.slug) : [];
const preview = app.status === "preview";
const wip = app.status === "private";
const unlisted = app.status === "unlisted";
const release = preview || wip ? null : await latestRelease(app);
// Version numbers go stale quickly: the list of releases on GitHub has them all, current
const releases = `https://github.com/${app.repo}/releases`;
const [first, ...more] = app.shots;
const page = new URL(`/${app.slug}/`, Astro.site).href;
const windows = onWindows(app);
const tryIt = tryOf(app);
/** A sentence with `code` in backticks, split into text and code. */
const parts = (text: string) => text.split("`").map((t, i) => ({ t, code: i % 2 === 1 }));
// The image for sharing is cut from the first screenshot by scripts/og.sh; without one, the logo
const og = existsSync(`public/og/${app.slug}.jpg`) ? `/og/${app.slug}.jpg` : undefined;
/** What the app is, for search engines. */
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: app.name,
  description: app.search,
  url: page,
  ...(og ? { image: new URL(og, Astro.site).href } : {}),
  ...(first ? { screenshot: new URL(`/shots/${first.file}${first.themed ? "-light" : ""}.webp`, Astro.site).href } : {}),
  applicationCategory: app.category ?? "UtilitiesApplication",
  operatingSystem: windows ? "Linux, Windows" : "Linux",
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  license: `https://spdx.org/licenses/${app.license ?? "MIT"}.html`,
  isAccessibleForFree: true,
  ...(preview || wip ? {} : { downloadUrl: releases }),
  codeRepository: sourceUrl(app),
  author: { "@type": "Organization", name: "be spex", url: Astro.site!.href },
};
---
<Base title={`${app.name} – ${app.kind} for ${platformText(app)} · be spex`} description={app.search} accent={app.accent} image={og} schema={wip ? undefined : schema} noindex={wip || unlisted}>
  <section class="app-hero wrap">
    <header class="app-title big">
      <img class="icon" src={iconOf(app)} alt="" width="84" height="84" />
      <div>
        <h1>{app.name}</h1>
        <p class="kind">
          {app.kind}{app.say && <span> · say “{app.say}”{app.ipa && <span class="ipa"> /{app.ipa}/</span>}</span>}{group && <span> · part of <a href={`/#${group.id}`}>{group.name}</a></span>}{windows && <span> · <Platforms app={app} text /></span>}
        </p>
      </div>
    </header>
    {wip && <p class="note wip"><strong>Work in progress · private.</strong> This page is not linked from the site and not meant to be found yet; {app.name} is not released.</p>}
    {preview && <p class="note">In preparation: {app.name} works and can be built from source, but there is no release and no package yet.</p>}
    <p class="tagline">{app.tagline}</p>
    <p class="lead">{app.description}</p>
    <p class="actions">
      <a class="btn primary" href="#get">{preview || wip ? `Try ${app.name}` : `Install ${app.name}`}</a>
      <a class="btn" href={sourceUrl(app)}>Source on GitHub</a>
    </p>
    <ul class="labels" aria-label="Works with">
      {app.labels.map((l) => <li>{l}</li>)}
    </ul>
  </section>

  {first ? (
    <section class:list={["wrap", "app-shot", { narrow: first.width < 2000 }]}>
      <Shot shot={first} eager bare={first.bare ?? !first.themed} />
    </section>
  ) : app.sample && (
    <section class="wrap app-shot narrow">
      <div class="shot"><Command lines={app.sample} /></div>
    </section>
  )}

  <section class="wrap features">
    <h2>What it does</h2>
    <ul>
      {app.features.map((f) => (
        <li><strong>{f.title}</strong>{f.text}</li>
      ))}
    </ul>
  </section>

  {app.modes && (
    <section class="wrap modes">
      <h2>{app.modes.title}</h2>
      {app.modes.intro && <p class="lead">{app.modes.intro}</p>}
      <ul>
        {app.modes.items.map((m) => (
          <li>
            <img src={m.image} alt="" width="150" height="150" loading="lazy" />
            <strong>{m.title}</strong>
            <span>{m.question}</span>
            {m.remark && <small>{m.remark}</small>}
            <code>{m.result}</code>
          </li>
        ))}
      </ul>
    </section>
  )}

  {more.map((s) => (
    <section class:list={["wrap", "app-shot", { narrow: s.width < 2000 }]}>
      <Shot shot={s} bare={s.bare ?? !s.themed} />
    </section>
  ))}

  {app.keys && (
    <section class="wrap features keys">
      <h2>Keyboard</h2>
      <table>
        <thead><tr><th scope="col">Where</th><th scope="col">Key</th><th scope="col">Action</th></tr></thead>
        <tbody>
          {app.keys.map((k) => (
            <tr><td>{k.where}</td><td><kbd>{k.key}</kbd></td><td>{k.action}</td></tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {group && (
    <section class="wrap features shared-block">
      <h2>Like every {group.name} viewer</h2>
      <ul>
        {group.shared.map((s) => (
          <li><strong>{s.title}</strong>{s.text}</li>
        ))}
      </ul>
    </section>
  )}

  {preview || wip ? (
    <section class="wrap install" id="get">
      <header class="section-head">
        <p class="eyebrow">Try it</p>
        <h2>{app.name} is not released yet</h2>
        {tryIt ? (
          <p class="lead">{parts(tryIt.text).map((p) => (p.code ? <code>{p.t}</code> : p.t))}</p>
        ) : (
          <p class="lead">It works, and you can build it from source: <a href={sourceUrl(app)}>the repository</a> explains how.</p>
        )}
      </header>
      {tryIt && <Command lines={tryIt.lines} />}
    </section>
  ) : (
  <section class="wrap install" id="get">
    <header class="section-head">
      <p class="eyebrow">Install</p>
      <h2>Get {app.name}</h2>
      {app.note && <p class="note">{app.note}</p>}
    </header>
    <div class:list={["install-grid", { three: windows }]}>
      <div>
        <h3>With APT (Debian, Ubuntu, Linux Mint)</h3>
        <Command
          label="Once: add the be spex repository"
          lines={[
            "curl -fsSLO https://bespex.run/apt/be-spex-archive-keyring.deb",
            "sudo apt install ./be-spex-archive-keyring.deb && sudo apt update",
          ]}
        />
        <Command lines={[`sudo apt install ${[app.pkg, ...(app.alsoInstall ?? []).map((a) => a.pkg)].join(" ")}`, ...(app.afterInstall ?? [])]} />
        {app.alsoInstall && (
          <ul class="also">
            {app.alsoInstall.map((a) => <li><code>{a.pkg}</code> {a.why}</li>)}
          </ul>
        )}
      </div>
      <aside>
        {app.appImage ? (
          <>
            <h3>As an AppImage</h3>
            <p>One file for any current distribution (x86_64). It runs as it is and offers updates itself.</p>
            <p>
              <a class="btn" href={release?.appImage ?? releases}>Download the AppImage</a>
            </p>
          </>
        ) : (
          <>
            <h3>Downloads</h3>
            <p>The package of every version is attached to its release on GitHub.</p>
          </>
        )}
        <p><a href={releases}>All versions, downloads and release notes on GitHub →</a></p>
      </aside>
      {windows && (
        <aside>
          <h3>For Windows</h3>
          <p>A setup program for Windows 10 and 11 (x64), no admin rights needed. {app.name} offers updates itself.</p>
          <p>
            <a class="btn" href={release?.windows ?? releases}>Download the installer</a>
          </p>
          <p class="small">The installer is not code-signed yet, so SmartScreen may warn about an unknown publisher: click <em>More info</em>, then <em>Run anyway</em>.</p>
        </aside>
      )}
    </div>
  </section>
  )}

  {siblings.length > 0 && (
    <section class="wrap siblings">
      <h2>The other {group!.name} viewers</h2>
      <ul>
        {siblings.map((s) => (
          <li>
            <a href={`/${s.slug}/`} style={`--accent: ${s.accent}`}>
              <img src={iconOf(s)} alt="" width="44" height="44" />
              <span><strong>{s.name}</strong>{s.kind}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
