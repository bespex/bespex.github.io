---
// The manual of CodeDeck (/codedeck/manual/<lang>/): every page is a Markdown file under
// src/pages/codedeck/manual/<lang>/ with this layout. Its frontmatter says where it stands:
//   title    heading of the page        nav      shorter title for the navigation (optional)
//   part     0 start, 1 introduction, 2 tutorial, 3 reference, 4 appendix
//   order    place within its part      purpose  what the page is for, shown below the heading
//   draft    true while the page is a plan: not indexed, marked as a draft
//   translation  on an English page: the German page it translates, e.g. /codedeck/manual/de/tutorial/
// The navigation is built from all pages of the same language; the link to the other language comes
// from `translation` (on a German page: the English page that names it).
import Base from "./Base.astro";
import { apps } from "../data/apps";

interface Frontmatter {
  title: string;
  nav?: string;
  part: number;
  order: number;
  purpose?: string;
  draft?: boolean;
  description?: string;
  translation?: string;
}
const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const lang = Astro.url.pathname.split("/")[3] ?? "de";
const words = {
  de: { manual: "Handbuch", parts: ["Start", "Einleitung", "Tutorial", "Nachschlagen", "Anhang"], purpose: "Zweck", draft: "Entwurf: Diese Seite ist ein Bauplan. Die Kästen „Arbeitsanweisung“ sagen, was hier entstehen soll; sie verschwinden, sobald der Inhalt steht.", back: "Zurück", next: "Weiter", app: "Zu CodeDeck", other: "English", otherLang: "en" },
  en: { manual: "Manual", parts: ["Start", "Introduction", "Tutorial", "Reference", "Appendix"], purpose: "Purpose", draft: "Draft: this page is a plan. The boxes “Instructions” say what is to be written here; they go once the content stands.", back: "Back", next: "Next", app: "To CodeDeck", other: "Deutsch", otherLang: "de" },
}[lang === "en" ? "en" : "de"];

type Page = { url: string; frontmatter: Frontmatter };
const every = Object.values(import.meta.glob<Page>("../pages/codedeck/manual/**/*.md", { eager: true }));
const all = every
  .filter((p) => p.url?.startsWith(`/codedeck/manual/${lang}/`))
  .sort((a, b) => a.frontmatter.part - b.frontmatter.part || a.frontmatter.order - b.frontmatter.order);
const here = all.findIndex((p) => p.url.replace(/\/$/, "") === Astro.url.pathname.replace(/\/$/, ""));
const previous = here > 0 ? all[here - 1] : null;
const next = here >= 0 && here < all.length - 1 ? all[here + 1] : null;
const parts = words.parts.map((name, i) => ({ name, pages: all.filter((p) => p.frontmatter.part === i) })).filter((p) => p.pages.length);
// The same page in the other language, else the other manual's start
const slash = (u: string) => u.replace(/\/?$/, "/");
const other =
  lang === "en"
    ? frontmatter.translation
    : every.find((p) => p.frontmatter.translation && slash(p.frontmatter.translation) === slash(Astro.url.pathname))?.url;
const otherUrl = slash(other ?? `/codedeck/manual/${words.otherLang}/`);
const accent = apps.find((a) => a.slug === "codedeck")?.accent;
// Until the manual is linked from the site (menu entry "Handbuch"), no page of it goes into search
// engines, finished or not; it is not in the sitemap either. Set to true at the launch.
const listed = false;
const label = (p: Page) => p.frontmatter.nav ?? p.frontmatter.title;
// Tutorial chapters carry their number, appendix pages their letter, in a column of their own, so
// the short labels stay on one line and line up.
const mark = (p: Page) =>
  p.frontmatter.order === 0 ? "" : p.frontmatter.part === 2 ? String(p.frontmatter.order) : p.frontmatter.part === 4 ? "ABCDEFGHIJ"[p.frontmatter.order - 1] : "";
---
<Base
  title={`${frontmatter.title} – CodeDeck ${words.manual}`}
  description={frontmatter.description ?? frontmatter.purpose ?? `CodeDeck ${words.manual}`}
  accent={accent}
  noindex={!listed || frontmatter.draft}
  lang={lang}
>
  <div class="wrap manual">
    <nav class="manual-nav" aria-label={words.manual}>
      <a class="manual-home" href={`/codedeck/manual/${lang}/`}>CodeDeck · {words.manual}</a>
      {parts.map((part) => (
        <div class="manual-part">
          {part.name !== words.parts[0] && <p>{part.name}</p>}
          <ul>
            {part.pages.map((p) => (
              <li><a href={p.url} aria-current={p === all[here] ? "page" : undefined} title={p.frontmatter.title}>{mark(p) && <span class="manual-mark">{mark(p)}</span>}{label(p)}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <a class="manual-app" href="/codedeck/">{words.app}</a>
      <a class="manual-app" href={otherUrl} hreflang={words.otherLang} lang={words.otherLang}>{words.other}</a>
    </nav>
    <article class="manual-page">
      {frontmatter.draft && <p class="note wip">{words.draft}</p>}
      <p class="eyebrow">{words.parts[frontmatter.part]}</p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.purpose && (
        <p class="manual-purpose"><strong>{words.purpose}:</strong> {frontmatter.purpose}</p>
      )}
      <div class="manual-body"><slot /></div>
      <footer class="manual-steps">
        {previous ? <a href={previous.url}>← {label(previous)}</a> : <span />}
        {next && <a href={next.url}>{label(next)} →</a>}
      </footer>
    </article>
  </div>
  <script is:inline>
    // Every page loads anew, and the navigation would start at its top again: keep where it was
    // scrolled to, or else bring the current page into view.
    (() => {
      const nav = document.querySelector(".manual-nav");
      if (!nav) return;
      const kept = sessionStorage.getItem("manual-nav");
      if (kept !== null) nav.scrollTop = Number(kept);
      const here = nav.querySelector('[aria-current="page"]');
      if (here) {
        const box = nav.getBoundingClientRect(), item = here.getBoundingClientRect();
        if (item.top < box.top || item.bottom > box.bottom) here.scrollIntoView({ block: "center" });
      }
      addEventListener("pagehide", () => sessionStorage.setItem("manual-nav", String(nav.scrollTop)));
    })();
  </script>
</Base>
