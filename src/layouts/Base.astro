---
import "@fontsource-variable/open-sans";
import "../styles/global.css";
import { onWindows, released } from "../data/apps";

interface Props {
  title: string;
  description: string;
  /** Accent colour of the page, e.g. an app's; the brand orange by default. */
  accent?: string;
  /** Image shown when the page is shared (1200×630), e.g. "/og/trisq.jpg"; the logo by default. */
  image?: string;
  /** Structured data (schema.org) describing the page to search engines. */
  schema?: object;
  /** A page not to be found yet: search engines are asked not to index it or follow its links. */
  noindex?: boolean;
  /** Language of the page, e.g. "de" for the German manual of CodeDeck. */
  lang?: string;
}
const { title, description, accent, image, schema, noindex, lang = "en" } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
/** "for Linux" as long as no released app also runs on Windows. */
const platforms = released.some(onWindows) ? "for Linux – some also for Windows" : "for Linux";
---
<!doctype html>
<html lang={lang} style={accent ? `--accent: ${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="be spex" />
    <meta property="og:image" content={new URL(image ?? "/be-spex.png", Astro.site)} />
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap bar">
        <a class="wordmark" href="/" aria-label="be spex – home"><span class="be">be</span><span class="spex">spex</span></a>
        <nav aria-label="Main">
          <a href="/#apps">Apps</a>
          <a href="/#install">Install</a>
          <a href="/#open-source">Open source</a>
          <a class="gh" href="https://github.com/bespex">GitHub</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-foot">
      <div class="wrap foot">
        <a class="wordmark small" href="/" aria-label="be spex – home"><span class="be">be</span><span class="spex">spex</span></a>
        <p>Apps for the way you work {platforms}. Free and open source.</p>
        <nav aria-label="Footer">
          <a href="https://github.com/bespex">GitHub</a>
          <a href="/apt/">Package repository</a>
          <a href="https://github.com/bespex/bespex.github.io">This site's source</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      // "Copy" buttons of the command blocks.
      document.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-copy]");
        if (!btn) return;
        navigator.clipboard.writeText(btn.closest(".cmd").querySelector("code").innerText).then(() => {
          btn.textContent = "Copied";
          setTimeout(() => (btn.textContent = "Copy"), 1600);
        });
      });
    </script>
    <script is:inline data-goatcounter="https://be-spex.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
